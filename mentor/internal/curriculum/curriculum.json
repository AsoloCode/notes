      "topics": [
        {"id": "mvcc", "title": "MVCC и изоляция", "material": "postgres-dev1/04 - DEV1-16. 03. Изоляция и многоверсионность", "key_points": ["xmin/xmax, снимки", "уровни изоляции и аномалии", "SI vs SSI", "видимость и vacuum"]},
        {"id": "wal", "title": "WAL и буферный кеш", "material": "postgres-dev1/05 - DEV1-16. 04.  Буферный кеш и журнал", "key_points": ["WAL, LSN, checkpoint", "shared_buffers и clock-sweep", "fsync, full_page_writes", "групповой commit"]},
        {"id": "logical", "title": "Логическая структура", "material": "postgres-dev1/06 - DEV1-16. 05.  Логическая структура", "key_points": ["кластер/база/схема/таблица", "системный каталог pg_catalog", "OID", "tablespace"]},
        {"id": "physical", "title": "Физическая структура", "material": "postgres-dev1/07 - DEV1-16. 06.  Физическая структура", "key_points": ["страницы 8КБ, heap tuples", "TOAST", "FILLFACTOR, HOT-обновления", "free space map"]},
        {"id": "planning", "title": "Планирование и выполнение", "material": "postgres-qpt/03 - QPT-16. 02. Планирование и выполнение", "key_points": ["parser → rewrite → planner → executor", "стоимостная модель", "EXPLAIN (ANALYZE, BUFFERS)", "оценки vs факт"]},
        {"id": "access", "title": "Методы доступа", "material": "postgres-qpt/04 - QPT-16. 03. Методы доступа", "key_points": ["Seq Scan", "Index Scan / Index Only Scan", "Bitmap Heap Scan", "cost и selectivity"]},
        {"id": "indexes", "title": "Типы индексов", "material": "postgres-qpt/06 - QPT-16. 05. Типы Индексов", "key_points": ["B-tree", "hash", "GIN/GiST для составных и полнотекста", "частичные и covering индексы"]},
        {"id": "sort", "title": "Сортировка и группировка", "material": "postgres-qpt/07 - QPT-16. 06. Сортировка", "key_points": ["Sort vs Index", "work_mem и внешняя сортировка", "HashAggregate vs GroupAggregate", "GROUP BY и HAVING"]},
