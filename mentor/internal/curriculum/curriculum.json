        {"id": "triggers", "title": "Триггеры и правила", "material": "postgres-dev1/18 - DEV1-16. 17. Триггеры", "key_points": ["BEFORE/AFTER/INSTEAD OF", "row vs statement", "transition tables", "риски и производительность"]},
        {"id": "plpgsql", "title": "Курсоры, динамический SQL, ошибки", "material": "postgres-dev1/14 - DEV1-16. 13. Курсоры", "key_points": ["курсоры и FETCH", "EXECUTE USING", "EXCEPTION и ошибки", "SQLSTATE"]},
        {"id": "types", "title": "Составные типы и массивы", "material": "postgres-dev1/16 - DEV1-16. 15. Массивы", "key_points": ["array и ANY", "composite типы", "jsonb vs json", "range-типы"]},
        {"id": "locking", "title": "Транзакции и блокировки", "key_points": ["pg_locks, deadlock", "FOR UPDATE/SHARE", "advisory locks", "SELECT ... SKIP LOCKED"]},
        {"id": "vacuum", "title": "VACUUM, autovacuum и bloat", "key_points": ["dead tuples и bloat", "autovacuum настройки", "VACUUM FULL vs REINDEX", "visibility map и index-only scan"]},
        {"id": "backup", "title": "Резервное копирование и репликация", "material": "postgres-dev1/21 - DEV1-16. 20.  Резервное копирование. Логическое резервирование", "key_points": ["pg_dump/pg_restore", "PITR и archive_mode", "physical vs logical replication", "репликация слотов"]},
        {"id": "tuning", "title": "Настройка параметров", "material": "postgres-qpt/17 - QPT-16. 16. Подходы к настройке", "key_points": ["shared_buffers, work_mem", "effective_cache_size", "random_page_cost", "connection pooling"]}
      ]
