        {"id": "stats", "title": "Статистика и селективность", "material": "postgres-qpt/12 - QPT-16. 11. Базовая статистика", "key_points": ["ANALYZE, pg_statistic", "гистограммы, MCV", "extended statistics", "почему оценки врут"]},
        {"id": "profiling", "title": "Профилирование", "material": "postgres-qpt/14 - QPT-16. 13. Профилирование", "key_points": ["pg_stat_statements", "auto_explain", "log_min_duration_statement", "pg_stat_user_tables"]},
        {"id": "materialize", "title": "Материализация", "material": "postgres-qpt/15 - QPT-16. 14. Материлизация", "key_points": ["CTE MATERIALIZED", "materialized views", "REFRESH", "когда кешировать результат"]},
