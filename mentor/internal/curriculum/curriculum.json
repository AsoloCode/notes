{
  "directions": [
    {
      "id": "go",
      "title": "Go",
      "goal": "Свободно объяснять модель памяти, планировщик, конкурентность и идиомы Go; уверенно проходить собеседование уровня middle/senior.",
      "topics": [
        {"id": "types", "title": "Основные типы данных", "material": "glubokiy-go/01 - основные типы данных/notes.md", "key_points": ["int vs int64 и размер слова", "zero value и nil", "переполнение и преобразования типов", "string — неизменяемый байтовый срез"]},
        {"id": "slices", "title": "Массивы и срезы", "material": "glubokiy-go/02 - массивы и срезы/notes.md", "key_points": ["array vs slice, len/cap", "внутреннее устройство slice header", "append и аллокации", "alias и утечки памяти через subslice"]},
        {"id": "strings", "title": "Строки и руны", "material": "glubokiy-go/03 - строки/notes.md", "key_points": ["string — UTF-8 байты", "rune vs byte", "strings.Builder vs concat", "иммутабельность и интернирование"]},
        {"id": "maps", "title": "Словари (map)", "material": "glubokiy-go/04 - словари/notes.md", "key_points": ["устройство hashmap, buckets", "эвакуация и рост", "порядок обхода не детерминирован", "map не потокобезопасна"]},
        {"id": "functions", "title": "Функции и замыкания", "material": "glubokiy-go/05 - функции/notes.md", "key_points": ["замыкания и захват переменных", "defer: порядок и аргументы", "escape analysis", "variadic и интерфейсы"]},
        {"id": "structs", "title": "Структуры данных", "material": "glubokiy-go/06 - структуры данных/notes.md", "key_points": ["embedding vs наследование", "выравнивание и padding", "методы с value/pointer receiver", "tags и сериализация"]},
        {"id": "interfaces", "title": "Интерфейсы", "material": "glubokiy-go/07 - интерфейсы/notes.md", "key_points": ["structural typing", "iface и eface, itab", "nil interface vs nil value", "typeswitch и type assertion"]},
        {"id": "errors", "title": "Обработка ошибок", "material": "glubokiy-go/08 - обработка ошибок/notes.md", "key_points": ["errors.Is/As, wrapping %w", "sentinel vs typed errors", "panic/recover — когда уместно", "не терять контекст"]},
        {"id": "generics", "title": "Дженерики и рефлексия", "material": "glubokiy-go/09 - дженерики и рефлексия/notes.md", "key_points": ["type parameters и constraints", "статическая диспетчеризация (gcshape/stenciling)", "reflect: цена и риски", "когда дженерики не нужны"]},
        {"id": "allocator", "title": "Аллокатор памяти", "material": "glubokiy-go/10 - аллокатор/notes.md", "key_points": ["mcache/mcentral/mheap", "size classes и span", "TCMalloc-происхождение", "почему важна локальность"]},
        {"id": "gc", "title": "Сборщик мусора", "material": "glubokiy-go/11 - сборщик мусора/notes.md", "key_points": ["mark-and-sweep, трёхцветный алгоритм", "write barrier", "GOGC и GOMEMLIMIT", "stop-the-world и latency"]},
        {"id": "scheduler", "title": "Планировщик и горутины", "material": "glubokiy-go/12 - планировщик и горутины/notes.md", "key_points": ["G-M-P модель, work stealing", "асинхронный преемпшн и sysmon", "горутина vs поток", "горутинные утечки"]},
        {"id": "sync", "title": "Примитивы синхронизации", "material": "glubokiy-go/13 - примитивы синхронизации/notes.md", "key_points": ["Mutex/RWMutex", "WaitGroup, Once, atomic", "memory model и happens-before", "false sharing"]},
        {"id": "channels", "title": "Каналы", "material": "glubokiy-go/14 - каналы/notes.md", "key_points": ["буферизация, закрытие", "select и default", "nil-канал блокирует", "patterns: fan-in/out, pipeline"]},
        {"id": "context", "title": "Контексты", "material": "glubokiy-go/15 - контексты/notes.md", "key_points": ["отмена и дедлайны", "дерево контекстов и утечки", "WithValue — когда нельзя", "context в API"]},
        {"id": "testing", "title": "Тестирование и бенчмарки", "key_points": ["table-driven tests", "testing.T.Cleanup/Parallel", "benchstat и -benchmem", "флаки и -race"]},
        {"id": "profiling", "title": "Профайлинг и pprof", "key_points": ["cpu/mem/block/mutex профили", "pprof и flamegraph", "trace", "как находить hot path"]}
      ]
    },
    {
