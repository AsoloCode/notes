{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asolocode.github.io/notes/system-design-interview/schemas/scenario.schema.json",
  "title": "Scenario bank (data/scenarios.json)",
  "type": "object",
  "required": ["schema", "scenarios"],
  "additionalProperties": true,
  "properties": {
    "schema": { "type": "string" },
    "rubric": { "type": "string" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/scenario" }
    }
  },
  "definitions": {
    "scenario": {
      "type": "object",
      "required": [
        "slug", "order", "title", "level", "scenario_path", "solution_path",
        "functional", "non_functional", "interviewer_questions",
        "components", "consistency", "bottlenecks", "trade_offs",
        "red_flags", "strong_signals"
      ],
      "additionalProperties": true,
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "level": { "enum": ["junior", "junior-mid", "mid", "mid-senior", "senior", "staff"] },
        "focus": { "type": "string" },
        "scenario_path": { "type": "string" },
        "solution_path": { "type": "string" },
        "functional": { "$ref": "#/definitions/stringArray" },
        "non_functional": { "$ref": "#/definitions/stringArray" },
        "interviewer_questions": { "$ref": "#/definitions/stringArray" },
        "key_metrics": { "type": "object", "additionalProperties": { "type": "string" } },
        "components": { "$ref": "#/definitions/stringArray" },
        "consistency": { "type": "object", "additionalProperties": { "type": "string" } },
        "bottlenecks": { "$ref": "#/definitions/stringArray" },
        "trade_offs": { "$ref": "#/definitions/stringArray" },
        "red_flags": { "$ref": "#/definitions/stringArray", "minItems": 1 },
        "strong_signals": { "$ref": "#/definitions/stringArray", "minItems": 1 }
      }
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
